#!/bin/sh
# Runs what CI runs (make verify: lint, test, coverage, e2e) before a push leaves this machine; a failure stops the
# push. `make setup` turns it on (git config core.hooksPath .githooks); skip it once with `git push --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
# The checks run on the working tree, so uncommitted changes take part although they are not pushed.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: note: uncommitted changes are part of this check but not of the push"
fi
echo "pre-push: make verify (lint, test, coverage, e2e), the same as CI"
exec make verify
